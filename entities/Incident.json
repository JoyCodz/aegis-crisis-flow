        "escalating",
        "contained",
        "resolved"
      ]
    },
    "zone_id": {
      "type": "string"
    },
    "zone_name": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "ai_reasoning": {
      "type": "string"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_responders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evacuation_active": {
      "type": "boolean"
    },
    "blocked_exits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "detected_at": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "severity",
    "status"
  ]
}