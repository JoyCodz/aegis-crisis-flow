{
  "name": "Responder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "security",
        "medic",
        "fire_warden",
        "manager",
        "maintenance"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "deployed",
        "en_route",
        "off_duty"
      ]
    },
    "zone_id": {
      "type": "string"
    },
    "zone_name": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workload": {
      "type": "number"
    },
    "assigned_incident_id": {
      "type": "string"
    },
    "radio_channel": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "role",
    "status"
  ]
}